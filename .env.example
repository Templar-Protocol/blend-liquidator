# blend-liquidator configuration.
#
# Copy to .env and edit. .env is gitignored; never commit a filled-in copy.

# ============================================
# SAFETY
# ============================================

# Report what would be done without submitting any transaction.
#
# Defaults to true, and this is the ONLY way to opt into live trading. The
# value is parsed strictly: exactly `true` or `false`, nothing else. `1`,
# `yes` and `on` are refused at startup rather than guessed at, because the
# dangerous direction is silent — a value quietly read as false would arm the
# bot while looking, to you, like it had been disarmed.
DRY_RUN=true

# ============================================
# LOGGING
# ============================================

# `text` for a terminal, `json` for a log shipper.
LOG_FORMAT=text

# Standard tracing filter. Overrides the built-in default when set.
# RUST_LOG=info,blend_liquidator=debug

# ============================================
# CHAIN
# ============================================

# Which network to sign for: `mainnet` or `testnet`, or give the passphrase
# itself with NETWORK_PASSPHRASE for any other network. One or the other.
NETWORK=testnet
# NETWORK_PASSPHRASE="Test SDF Network ; September 2015"

# Soroban RPC endpoint.
RPC_URL=https://soroban-testnet.stellar.org

# For a keyed RPC provider: the header name is an ordinary setting, the key
# is a secret and is read from the environment only — it is never a
# command-line argument, because argv is world-readable.
# RPC_API_KEY_HEADER=X-Api-Key
# RPC_API_KEY=

# Inclusion-fee floors in stroops. The fee-stats p70 (normal) or p90 (high
# priority) percentile is used when it is higher.
BASE_FEE=5000
HIGH_FEE=10000

# Ledgers a submitted transaction stays valid and is polled for. Must be at
# least 1: the transaction's ledger bound is derived from this and is
# exclusive, so a zero window would make every transaction unlandable
# before it starts.
# At least 1; at most 100000.
TX_POLL_LEDGERS=3

# ============================================
# STORE
# ============================================

# Postgres. May carry a password, so it is a secret: it is read from the
# environment only and never logged. `make db-up` starts the compose
# service this default points at.
#
# This is the *host-side* address — the port docker-compose publishes on
# 127.0.0.1 — which is what `cargo test`, `sqlx migrate run` and a `cargo
# run` on the host need. The bot running inside the compose network reaches
# Postgres by service name instead, and docker-compose.yml sets that in the
# liquidator service's `environment:` block, which overrides this file.
DATABASE_URL=postgres://liquidator:liquidator@127.0.0.1:55432/liquidator

# Connections in the pool. Every store call is short and none is held
# across a network await, so a handful is plenty.
DATABASE_MAX_CONNECTIONS=5

# ============================================
# POOLS
# ============================================

# The pools this bot follows: one [[pools]] table per pool, naming the
# assets it will bid with and take as collateral and the filler's profit
# rules. Give exactly one of these — a path, or the file's contents inline
# for an environment with no volume to mount — never both. See
# pools.example.toml for the schema.
# POOLS_FILE=./pools.example.toml
# POOLS_TOML="""
# [[pools]]
# address = "C..."
# ...
# """

# ============================================
# STARTUP
# ============================================

# `loop` follows the configured pools until shut down. `check-config`
# validates everything, prints it redacted, and exits — a quick sanity
# check before committing to `loop`.
RUN_MODE=loop

# ============================================
# TRACKER
# ============================================

# How often the poller asks the RPC for chain head, in milliseconds.
# At least 100; at most 60000.
POLL_INTERVAL_MS=1000

# A tracked user whose row is older than this many ledgers is refreshed, so
# accrued interest is never missed.
USER_REFRESH_LEDGERS=241920

# How many stale users to refresh per tick.
# At least 1; at most 1000.
REFRESH_BATCH=20

# How often the full scan reports the least healthy borrowers, in ledgers.
FULL_SCAN_LEDGERS=1200

# The health factor the full scan reports below.
SCAN_HF_THRESHOLD=1.2

# ============================================
# AUCTIONEER
# ============================================

# The health factor at or below which a borrower is liquidatable. Below the
# contract's own strict threshold (1.0) on purpose: the margin absorbs
# rounding and the interest accrued between planning and execution, so an
# auction the bot creates is still one the contract accepts when it lands.
LIQ_HF_THRESHOLD=0.998

# The health factor a liquidation aims to leave the borrower at. The
# contract refuses a post-liquidation health factor at or above 1.15
# (InvalidLiqTooLarge) or below 1.03 (InvalidLiqTooSmall), so this sits
# between them with room for the auction to be filled a ledger or two later
# than planned.
TARGET_HF=1.06

# How often, in ledgers, prices are re-read and a significant move flags
# the borrowers it moved against.
ORACLE_SCAN_LEDGERS=60

# How far a price must move from its reference, in basis points, to be
# worth rechecking the borrowers exposed to it.
PRICE_DELTA_BPS=250

# How many times a rejected liquidation percent is adjusted against the
# contract's own answer before the borrower is left until the next recheck.
# At least 1: zero would make the walk never simulate at all, so every
# liquidation would be skipped as though the contract had refused it,
# silently. Refused at startup rather than clamped, for the same reason
# DRY_RUN above is parsed strictly.
PLAN_ITERATIONS=5

# Ledger ticks to wait after startup before any submission is attempted.
# Zero submits as soon as the bot is ready; a nonzero value gives a poller
# that is catching up on a backlog room to reach current chain state before
# the bot acts on health factors it has not yet re-verified against it.
STARTUP_DELAY_LEDGERS=0

# The key the auctioneer signs auction-creation transactions with. Unset
# falls back to FILLER_SECRET_KEY (wired in by a later phase); with neither
# set, the auctioneer simply never signs — the ordinary dry-run deployment,
# not an error. Like every other secret this is read from the environment
# only: it is never a command-line argument, because argv is world-readable.
# AUCTIONEER_SECRET_KEY=

# ============================================
# SEED
# ============================================

# The analytics API the tracker seeds its initial tracked-user set from.
# Empty disables it, leaving SEED_FILE (if set) as the only seed source.
SEED_URL=https://api.blend.templarfi.org

# Only accounts at or below this health factor are seeded.
SEED_HF_MAX=10

# An optional static file of pool-to-account lists, for a network the
# analytics API does not cover. See seed.example.toml for the schema.
# SEED_FILE=./seed.example.toml
