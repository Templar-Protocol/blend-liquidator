# blend-liquidator configuration.
#
# Copy to .env and edit. .env is gitignored; never commit a filled-in copy.

# ============================================
# SAFETY
# ============================================

# Report what would be done without submitting any transaction.
#
# Defaults to true, and this is the ONLY way to opt into live trading. The
# value is parsed strictly: exactly `true` or `false`, nothing else. `1`,
# `yes` and `on` are refused at startup rather than guessed at, because the
# dangerous direction is silent — a value quietly read as false would arm the
# bot while looking, to you, like it had been disarmed.
DRY_RUN=true

# ============================================
# LOGGING
# ============================================

# `text` for a terminal, `json` for a log shipper.
LOG_FORMAT=text

# Standard tracing filter. Overrides the built-in default when set.
# RUST_LOG=info,blend_liquidator=debug

# ============================================
# CHAIN
# ============================================

# Which network to sign for: `mainnet` or `testnet`, or give the passphrase
# itself with NETWORK_PASSPHRASE for any other network. One or the other.
NETWORK=testnet
# NETWORK_PASSPHRASE="Test SDF Network ; September 2015"

# Soroban RPC endpoint. Put no credential in it: an RPC call that fails at
# the transport level logs the full URL, and a run of such failures sends it
# to the notification channel. A keyed provider's key goes in RPC_API_KEY.
RPC_URL=https://soroban-testnet.stellar.org

# For a keyed RPC provider: the header name is an ordinary setting, the key
# is a secret and is read from the environment only — it is never a
# command-line argument, because argv is world-readable.
# RPC_API_KEY_HEADER=X-Api-Key
# RPC_API_KEY=

# Inclusion-fee floors in stroops. The fee-stats p70 (normal) or p90 (high
# priority) percentile is used when it is higher.
BASE_FEE=5000
HIGH_FEE=10000

# Ledgers a submitted transaction stays valid and is polled for. Must be at
# least 1: the transaction's ledger bound is derived from this and is
# exclusive, so a zero window would make every transaction unlandable
# before it starts.
# At least 1; at most 100000.
TX_POLL_LEDGERS=3

# ============================================
# STORE
# ============================================

# Postgres. May carry a password, so it is a secret: it is read from the
# environment only and never logged. `make db-up` starts the compose
# service this default points at.
#
# This is the *host-side* address — the port docker-compose publishes on
# 127.0.0.1 — which is what `cargo test`, `sqlx migrate run` and a `cargo
# run` on the host need. The bot running inside the compose network reaches
# Postgres by service name instead, and docker-compose.yml sets that in the
# liquidator service's `environment:` block, which overrides this file.
DATABASE_URL=postgres://liquidator:liquidator@127.0.0.1:55432/liquidator

# Connections in the pool. Every store call is short and none is held across
# a network await, so this does not need to be large — but it does need to
# cover every task that queries concurrently: one ledger poller per pool,
# the tracker, the auctioneer and the filler. Roughly `pools + 3`, and the
# default of 10 covers up to seven pools. Sizing it below that does not
# deadlock, it times out acquiring a connection — and every store error in
# this bot is fatal, so a load spike becomes a process exit.
DATABASE_MAX_CONNECTIONS=10

# ============================================
# POOLS
# ============================================

# The pools this bot follows: one [[pools]] table per pool, naming the
# assets it will bid with and take as collateral and the filler's profit
# rules. Give exactly one of these — a path, or the file's contents inline
# for an environment with no volume to mount — never both. See
# pools.example.toml for the schema.
# POOLS_FILE=./pools.example.toml
# POOLS_TOML="""
# [[pools]]
# address = "C..."
# ...
# """

# ============================================
# STARTUP
# ============================================

# `loop` follows the configured pools until shut down. `check-config`
# validates everything, prints it redacted, and exits — a quick sanity
# check before committing to `loop`.
RUN_MODE=loop

# ============================================
# TRACKER
# ============================================

# How often the poller asks the RPC for chain head, in milliseconds.
# At least 100; at most 60000.
POLL_INTERVAL_MS=1000

# A tracked user whose row is older than this many ledgers is refreshed, so
# accrued interest is never missed.
USER_REFRESH_LEDGERS=241920

# A rate, not a cap: how many stale users the tracker refreshes per tick,
# how many flagged borrowers the auctioneer decides and acts on per pool per
# tick, and the page size the full scan flags with. It deliberately does not
# bound the oracle scan — a price move flags every borrower exposed to it,
# because the reference re-anchors on the move and a borrower the scan
# skipped would not be picked up by the next one either.
# At least 1; at most 1000.
REFRESH_BATCH=20

# How often the full scan reports the least healthy borrowers, in ledgers.
FULL_SCAN_LEDGERS=1200

# The health factor the full scan reports below.
SCAN_HF_THRESHOLD=1.2

# ============================================
# AUCTIONEER
# ============================================

# The health factor at or below which a borrower is liquidatable. Below the
# contract's own strict threshold (1.0) on purpose: the margin absorbs
# rounding and the interest accrued between planning and execution, so an
# auction the bot creates is still one the contract accepts when it lands.
LIQ_HF_THRESHOLD=0.998

# The health factor a liquidation aims to leave the borrower at. The
# contract refuses a post-liquidation health factor above 1.15
# (InvalidLiqTooLarge) or below 1.03 (InvalidLiqTooSmall), both checks
# strict, so this sits between them with room for the auction to be filled
# a ledger or two later than planned.
#
# At least 1.03 and below 1.15, refused at startup rather than clamped, for
# the same reason DRY_RUN above is parsed strictly. The lower bound is the
# contract's; the upper one is this bot's own margin, since the contract
# itself accepts exactly 1.15.
# Zero is the failure worth naming: the planned excess is then never
# positive, so every liquidatable borrower is skipped as "no plan", for
# ever, and nothing warns. Above the band fails the other way, burning
# PLAN_ITERATIONS simulations per borrower before skipping it.
#
# LIQ_HF_THRESHOLD must also sit strictly below SCAN_HF_THRESHOLD: the full
# scan only flags borrowers strictly below the latter, so a liquidation
# threshold at or above it names borrowers nothing ever flags for a
# decision. That pair is checked at startup too, and equality is refused.
TARGET_HF=1.06

# How often, in ledgers, prices are re-read and a significant move flags
# the borrowers it moved against. Zero is refused at parse: it would not
# mean "every ledger", it would switch the oracle scan off entirely.
ORACLE_SCAN_LEDGERS=60

# How far a price must move from its reference, in basis points, to be
# worth rechecking the borrowers exposed to it. At least 1: zero would
# compute a delta of 0 for an unchanged price, which falls through to a
# spurious "Down" on equality and flags every borrower on every scan,
# forever. Refused at startup rather than clamped, for the same reason
# DRY_RUN above is parsed strictly.
PRICE_DELTA_BPS=250

# How many times a rejected liquidation percent is adjusted against the
# contract's own answer before the borrower is left until the next recheck.
# At least 1: zero would make the walk never simulate at all, so every
# liquidation would be skipped as though the contract had refused it,
# silently. Refused at startup rather than clamped, for the same reason
# DRY_RUN above is parsed strictly.
PLAN_ITERATIONS=5

# Ledgers the chain must advance past the first tick a task sees before that
# task submits anything; the auctioneer and the filler each count their own.
# It is a distance in ledgers, not a number of wakeups: with several pools
# configured each task is woken once per pool per ledger, and counting
# wakeups would make this knob elapse that many times sooner.
# Zero submits as soon as the bot is ready. Its use is a rolling deploy that
# runs two revisions at once: set above the old revision's shutdown drain,
# converted from seconds to ledgers, it keeps the new revision from
# submitting while the old one still may.
STARTUP_DELAY_LEDGERS=0

# The key the auctioneer signs auction-creation transactions with. Unset, it
# falls back to FILLER_SECRET_KEY — so one key is the ordinary deployment
# and a separate auctioneer key is the option, not the requirement; with
# neither set the auctioneer still decides and records, it just never signs,
# which is the ordinary dry-run deployment and not an error. Like every
# other secret these are read from the environment only: neither is a
# command-line argument, because argv is world-readable.
#
# Both are parsed when both are set, even though at most one of them signs:
# BOTH addresses go into the set the auctioneer refuses to create a
# liquidation auction against, and an address the bot must not act on is
# worth a startup error rather than a key that quietly does not exist. So a
# malformed FILLER_SECRET_KEY fails startup even when AUCTIONEER_SECRET_KEY
# is what would sign. The error names the variable and never the value.
#
# Two rules bind the pair, both refused at startup rather than worked
# around. FILLER_SECRET_KEY is REQUIRED when DRY_RUN=false: the filler
# signs with its own key only — never the auctioneer's — so an armed bot
# without it would create auctions and never fill one. And the two must not
# be the SAME key: two roles on one key would want two submission queues on
# one key, which is the sequence-number race the per-key queue exists to
# make unreachable. Sharing one key is spelled by leaving
# AUCTIONEER_SECRET_KEY unset, not by setting both to the same value.
# AUCTIONEER_SECRET_KEY=
# FILLER_SECRET_KEY=

# ============================================
# FILLER
# ============================================

# The pool's own min_health_factor (in the pools file above) is multiplied
# by this for the floor the filler keeps its own position at or above after
# a fill.
# At least 1, refused under rather than clamped: under one the floor would
# sit BELOW the pool's min_health_factor — the minimum you stated — and a
# fill would be allowed to leave the filler under it by design.
HF_SAFETY_MULTIPLIER=1.1

# How often, in ledgers, an auction the filler has already planned is
# planned again. Zero is refused at parse: it does not mean "every ledger",
# it means re-planning every open auction on every ledger — a chain read per
# auction per ledger, which is REPLAN_NEAR_LEDGERS's job and only near the
# fill ledger.
REPLAN_LEDGERS=10

# Within this many ledgers of its planned fill ledger an auction is planned
# again on every ledger, because that is where a stale plan costs the fill.
# Zero IS meaningful here and is allowed: it means re-plan only at the fill
# ledger itself.
REPLAN_NEAR_LEDGERS=5

# XLM the filler never spends, so it can always pay for the fills it plans.
# Decimal XLM, and XLM has 7 decimals, so the parsed value is exactly this
# many stroops (50 XLM = 500000000 stroops). Startup checks the filler
# account holds at least this: an error when armed, a warning in dry-run.
XLM_FEE_RESERVE=50

# The estimated profit, in the pool oracle's own units, at or above which a
# fill pays HIGH_FEE rather than BASE_FEE. A fill that lapses is money
# another bot takes, so the fee tier is worth buying above a threshold you
# set; below it the base fee keeps a marginal fill economical.
HIGH_FEE_PROFIT_THRESHOLD=10

# The longest the filler's wallet balances go unread, in seconds; they are
# also re-read after every transaction that landed or may have landed. Zero
# is refused at parse: it would read every balance of every asset on every
# tick, which is a round trip per asset per ledger for a wallet that moves
# only when this bot moves it.
INVENTORY_REFRESH_SECS=30

# How long a repeated notification of the same (pool, account, kind) is
# suppressed for, in hours. Two kinds go through it this phase: leftover
# unwind debt the wallet cannot repay after an idle pass, and a pool
# whose unwind pass has moved nothing three times in a row — one
# notification per stalled episode, so a second stalled episode in the
# same pool inside the cooldown is deduplicated away and goes unreported.
# Both are logged rather than delivered anywhere unless TELEGRAM_BOT_TOKEN
# and TELEGRAM_CHAT_ID are set below. Zero is refused at parse: there is
# no "no cooldown" spelling, only shorter ones.
FAILURE_NOTIFICATION_COOLDOWN_HOURS=24

# ============================================
# HTTP
# ============================================

# The /healthz, /livez and /metrics server. Unset (both PORT and HTTP_PORT
# absent) disables it entirely — every deployment that sets neither. PORT is
# honoured for Cloud Run, which injects it; HTTP_PORT is the port to give
# a deployment that does not. PORT wins when both are set, so a deployment
# that also sets HTTP_PORT for some other reason does not silently lose
# the platform's binding.
#PORT=8080
#HTTP_PORT=8080

# The address the server binds. Loopback by default, so nothing outside
# this host can reach it unless asked to. Cloud Run cannot route to a
# loopback listener, so that deployment sets this to 0.0.0.0 — behind an
# ingress that admits only its probes and scraper: the endpoints carry no
# authentication, and /healthz costs a store ping per request.
#HTTP_BIND_ADDR=127.0.0.1

# /healthz answers ready only while the processed ledger is within this
# many ledgers of chain head. Zero is refused at parse: a bot exactly at
# head would then report not-ready on every ledger boundary its own poll
# interval crosses, which is not a readiness bound at all.
#
# The lag is not the only rule: /healthz also needs a chain head that was
# read recently (within the same window /livez allows a poller to go
# silent for — five poll intervals plus one worst-case backoff) and a
# store that answers a ping within five seconds. An RPC outage stops the
# processed ledger and the head together, so a bot following nothing
# would otherwise show a lag of zero. /livez, for its part, measures a
# pool whose poller has never run at all from the process's start, so the
# initial seed is not read as a poller that has stopped.
HEALTH_MAX_LAG_LEDGERS=10

# ============================================
# TELEGRAM
# ============================================

# The notification channel. Both or neither: either alone is a startup
# error, because a token with nowhere to send is as useless as a
# destination with nothing to send it with.
#
# The token is a secret and is read from the environment only — it is
# never a command-line argument, because argv is world-readable.
#TELEGRAM_BOT_TOKEN=
#TELEGRAM_CHAT_ID=

# ============================================
# SEED
# ============================================

# The analytics API the tracker seeds its initial tracked-user set from.
# Empty disables it, leaving SEED_FILE (if set) as the only seed source.
SEED_URL=https://api.blend.templarfi.org

# Only accounts at or below this health factor are seeded.
SEED_HF_MAX=10

# An optional static file of pool-to-account lists, for a network the
# analytics API does not cover. See seed.example.toml for the schema.
# SEED_FILE=./seed.example.toml
