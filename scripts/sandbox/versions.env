# versions.env — every pin the sandbox tier builds on: source URLs, their
# SHA-256s, the stellar CLI release and its tarball hashes, and the
# quickstart image pin — plus the sqlx-cli version, which is not the
# sandbox's but has the same problem (two places install it) and so is
# pinned in the same one file. Plain `KEY=value` lines, no expansion or
# command substitution, so this file is both `source`-able by a script
# under `set -euo pipefail` and greppable by a workflow that only wants
# one key.
#
# Nothing selects this file at run time: scripts/sandbox/lib.sh sources it
# from its own directory, and the two workflows and post-create.sh reach
# it by a fixed repo-relative path. It names the passphrase the standalone
# gate compares against and the hash every artefact is verified by, so an
# environment override of *which* file is read would defeat both at once.
#
# Every wasm is the prebuilt, optimised release asset — the bytes the
# contracts were actually deployed from — not a source build. The reason is
# what the pin is for: a hash over a published artefact is checkable by
# anyone, at any time, against bytes that cannot change, whereas a build
# from source reproduces only as far as the toolchain does, and a sandbox
# whose artefacts differ from the deployed ones proves nothing about the
# deployed ones. Reversing this is a decision, not a build fix; see route 3
# of docs/specs/2026-09-20-adr-0008-fork-semantics.md's section 6, which
# proposes exactly that for the fork and says what it costs.

# blend-contracts-v2, tag v2.0.0, commit c19abee. The per-contract release
# tags carry a further `_cli22.0.1` suffix (the CLI version the release was
# built with); comet.wasm has no release asset and is fetched from the
# commit directly.
BLEND_CONTRACTS_TAG=v2.0.0
BLEND_CONTRACTS_COMMIT=c19abee5b9be4f49e0cda9057e87d343e5dcc095

# 57328 bytes
POOL_WASM_URL=https://github.com/blend-capital/blend-contracts-v2/releases/download/v2.0.0_pool_cli22.0.1/pool_v2.0.0.wasm
POOL_WASM_SHA256=a41fc53d6753b6c04eb15b021c55052366a4c8e0e21bc72700f461264ec1350e

# 30772 bytes
BACKSTOP_WASM_URL=https://github.com/blend-capital/blend-contracts-v2/releases/download/v2.0.0_backstop_cli22.0.1/backstop_v2.0.0.wasm
BACKSTOP_WASM_SHA256=c1f4502a757e25c611f5a159bc1ab0eef64085adac6c68123dca66e87faffbc2

# 3230 bytes
POOL_FACTORY_WASM_URL=https://github.com/blend-capital/blend-contracts-v2/releases/download/v2.0.0_pool-factory_cli22.0.1/pool-factory_v2.0.0.wasm
POOL_FACTORY_WASM_SHA256=31328050548831f63d2b72e37bcfd0bb7371b7907135755dbe09ed434d755ca9

# 29046 bytes — the BLND:USDC liquidity pool the backstop token is a share
# of; no release asset, fetched from BLEND_CONTRACTS_COMMIT directly.
COMET_WASM_URL=https://raw.githubusercontent.com/blend-capital/blend-contracts-v2/c19abee5b9be4f49e0cda9057e87d343e5dcc095/comet.wasm
COMET_WASM_SHA256=5d721fa580714291f6846fc01738e86d70acb47e449ea75312e272a0f7436dd8

# 9963 bytes — script3/sep-40-oracle v1.2.0, the mock the contracts' own
# test suite uses.
MOCK_ORACLE_WASM_URL=https://raw.githubusercontent.com/script3/sep-40-oracle/v1.2.0/sep-40/src/testutils/mock_sep_40_oracle.wasm
MOCK_ORACLE_WASM_SHA256=c626b16160c3e3a48e21294acecbc0e2c4ec5a8e81c2ca35d86e8abe28d9256e

# stellar CLI release. No checksum asset is published for it, so both
# tarball hashes below were computed once, by hand, from this exact
# release and are pinned here — re-derive both together if this version
# ever moves.
STELLAR_CLI_VERSION=28.0.0
STELLAR_CLI_URL_X86_64=https://github.com/stellar/stellar-cli/releases/download/v28.0.0/stellar-cli-28.0.0-x86_64-unknown-linux-gnu.tar.gz
STELLAR_CLI_SHA256_X86_64=207544486734fccb4df1afc4a7745478f9f1e21688b2f9506f0ef36f60ce3fdc
STELLAR_CLI_URL_AARCH64=https://github.com/stellar/stellar-cli/releases/download/v28.0.0/stellar-cli-28.0.0-aarch64-unknown-linux-gnu.tar.gz
STELLAR_CLI_SHA256_AARCH64=8d8e5ea9bb441a19e99a7a7a4809df3f758c9654265c76953436fb7e9288b9ff

# stellar/quickstart, pinned by digest. QUICKSTART_TAG is a human label
# only — every script pulls "$QUICKSTART_IMAGE@$QUICKSTART_DIGEST", never
# the tag, so a re-push under the same tag can never silently change what
# runs. To bump: pick the newest non-nightly, non-pr `v…-latest` tag (the
# `latest` channel) from https://hub.docker.com/r/stellar/quickstart/tags,
# then `docker buildx imagetools inspect docker.io/stellar/quickstart:<tag>`
# and take the manifest-LIST digest printed at the top (not either
# platform's own digest below it) — the list digest is what resolves on
# both this machine's aarch64 and the amd64 CI runner. Update both keys
# together.
QUICKSTART_IMAGE=docker.io/stellar/quickstart
QUICKSTART_TAG=v669-b1438.1-latest
QUICKSTART_DIGEST=sha256:bed2d4b5fa0bc569ec2214eb6e58312e6b09eb230c5194bcb0eec59a89a5399c

# The passphrase every sandbox script refuses to proceed without seeing
# from the RPC's own getNetwork — never a public network's.
SANDBOX_PASSPHRASE="Standalone Network ; February 2017"

# sqlx-cli, which .github/workflows/ci.yml and .devcontainer/post-create.sh
# both install — CI to apply the migrations and check the committed
# offline query metadata, the dev container for `make sqlx-prepare` and
# `make sandbox-down`'s database sweep. One version because the offline
# metadata in .sqlx/ is what the two agree about: a dev container on
# another sqlx-cli regenerates a file CI then rejects, and nothing about
# the disagreement names itself.
#
# post-create.sh reads this key; ci.yml names its version as a literal on
# its own install line, and scripts/check-repo-invariants.sh fails unless
# that literal equals this value — the same cross-file equality the
# three-way Rust pin rests on. Bump both together, in step with the `sqlx`
# dependency in Cargo.toml.
SQLX_CLI_VERSION=0.9.0
